# ============================================================
# Variables de entorno. Copia este archivo como ".env.local"
# y rellena los valores. NUNCA subas ".env.local" a Git.
# ============================================================

# Clave de Google Gemini para el asistente con IA.
# Obtenla en https://aistudio.google.com/apikey (empieza por "AIza...").
# En Vercel se configura en: Settings -> Environment Variables.
GEMINI_API_KEY=AIza...

# (Opcional) URL absoluta de la función del chat, solo si la alojas
# en un dominio distinto al del sitio. Por defecto usa /api/chat.
# NEXT_PUBLIC_CHAT_API_URL=https://tu-funcion.vercel.app/api/chat

# Google Analytics 4 (para medir visitas y campañas).
# Se crea en https://analytics.google.com -> Administrar -> Flujos de datos.
# Es el "ID de medición" y empieza por "G-". Si se deja vacío, no se carga.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel (para medir campañas de Facebook/Instagram).
# Se crea en https://business.facebook.com -> Administrador de eventos.
# Es un ID numérico. Si se deja vacío, no se carga.
# NEXT_PUBLIC_FB_PIXEL_ID=000000000000000
